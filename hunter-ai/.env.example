# HUNTER AI — modèle de configuration.
# Copiez ce fichier en `.env` (cp .env.example .env) puis modifiez les valeurs.
# Le fichier `.env` n'est JAMAIS versionné. Ne collez jamais ces valeurs dans un chat.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Paris

# --- Base de données PostgreSQL ---
POSTGRES_USER=hunter
# Changez ce mot de passe (ex. : openssl rand -hex 24)
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=hunter
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3000
# Jeton exigé pour les modifications. Obligatoire si APP_ENV=production (sinon refus).
API_ACCESS_TOKEN=
# Au-delà de ce délai (heures), les données sont signalées comme périmées
STALE_AFTER_HOURS=24

# --- Frontend ---
# URL du backend vue depuis le serveur Next.js (dans Docker : http://backend:8000)
BACKEND_URL=http://backend:8000

# --- Notifications Telegram (optionnel, Phase 8) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
