# HUNTER AI — modèle de configuration.
# Copiez ce fichier en `.env` (cp .env.example .env) puis modifiez les valeurs.
# Le fichier `.env` n'est JAMAIS versionné. Ne collez jamais ces valeurs dans un chat.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Paris

# --- Base de données PostgreSQL ---
POSTGRES_USER=hunter
# Changez ce mot de passe (ex. : openssl rand -hex 24)
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=hunter
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3000
# Jeton exigé pour les modifications. Obligatoire si APP_ENV=production (sinon refus).
API_ACCESS_TOKEN=
# Au-delà de ce délai (heures), les données sont signalées comme périmées
STALE_AFTER_HOURS=24
# Taux de conversion vers l'euro (1 unité de devise = X EUR), ex. : USD=0.9512,GBP=1.1890
# Vide par défaut : les prix en devise étrangère restent « non déterminés » en EUR.
# Source conseillée : taux de référence de la BCE, en notant la date utilisée.
FX_RATES_TO_EUR=

# --- Frontend ---
# URL du backend vue depuis le serveur Next.js (dans Docker : http://backend:8000)
BACKEND_URL=http://backend:8000

# --- eBay Browse API (optionnel) ---
# Créez un compte sur https://developer.ebay.com, puis un « keyset » Production.
# Copiez ici l'App ID (Client ID) et le Cert ID (Client Secret). Ne les collez jamais dans un chat.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production ou sandbox (bac à sable eBay, données factices)
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_FR
# Plafond d'appels par jour (limite eBay par défaut : 5000)
EBAY_DAILY_CALL_BUDGET=4500

# --- AliExpress Affiliate API (optionnel) ---
# Open Platform (https://openservice.aliexpress.com) → votre application « Affiliate API » :
# App Key et App Secret. Tracking ID : depuis https://portals.aliexpress.com (facultatif).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Plafond d'appels par jour fixé par HUNTER AI (AliExpress ne publie pas de quota)
ALIEXPRESS_DAILY_CALL_BUDGET=1000

# --- Notifications Telegram (optionnel, Phase 8) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
